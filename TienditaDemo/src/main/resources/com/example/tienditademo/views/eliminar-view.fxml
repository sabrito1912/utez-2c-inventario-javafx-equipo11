<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.tienditademo.controllers.EliminarController"
            prefHeight="400.0" prefWidth="600.0">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label fx:id="" text="ID"/>
    <TextField text="Ingresar ID"/>
    <Label fx:id="" text="Nombre"/>
    <TextField text="Ingresar nombre"/>

    <HBox spacing="10">
        <Button text="Eliminar" onAction="#eliminar"/>
        <Button text="Regresar" onAction="#regresar"/>
    </HBox>

</VBox>
