<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="180.0" prefWidth="320.0" spacing="15.0" style="-fx-font-family: 'Tahoma'; -fx-font-size: 14px;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tienditademo.controllers.EliminarController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label style="-fx-font-family: 'Verdana'; -fx-font-size: 16px;" text="Eliminar Producto" />

    <Label text="Ingresa el ID del producto que deseas eliminar:" />
    <TextField fx:id="txtIdEliminar" promptText="Ej. 001" />

    <HBox alignment="CENTER_RIGHT" spacing="15">
        <children>
            <Button onAction="#cancelar" text="Cancelar" style="-fx-font-family: 'Verdana';" />
            <Button onAction="#eliminar" text="Eliminar" style="-fx-text-fill: red; -fx-font-family: 'Verdana';" />
        </children>
    </HBox>
</VBox>